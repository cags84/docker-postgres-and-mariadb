# ============================================================================
# Secretos — lo más importante de este archivo.
# El .env lleva las contraseñas reales de las bases; .env.example es la
# plantilla y sí se versiona.
# ============================================================================
.env
.env.*
!.env.example

# ============================================================================
# Backups de las bases de datos
# ./backup.sh escribe en ./backups; los dumps manuales que documenta el
# README caen en la raíz del repo.
# La barra inicial ancla el patrón a la raíz a propósito: sin ella, un
# *.sql suelto también taparía futuros scripts de initdb/.
# ============================================================================
backups/
/*.sql
/*.sql.gz
/*.dump

# ============================================================================
# Ruido del sistema operativo y del editor
# El stack se usa en macOS, Windows y Linux, así que van los tres.
# ============================================================================
.DS_Store
Thumbs.db
[Dd]esktop.ini
*~
.vscode/
