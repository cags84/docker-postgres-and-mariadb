# ============================================================================
# Copia este archivo a .env y ajusta los valores:  cp .env.example .env
# Todas las variables de aquí son leídas por docker-compose.yml.
# ============================================================================

# --- General --------------------------------------------------------------
# Zona horaria de todo el stack. Si algún servicio necesita otra distinta,
# puedes añadir su override: POSTGRES_TZ, MARIADB_TZ, PMA_TZ, PGADMIN_TZ,
# BACKUP_TZ. Rara vez hace falta.
TZ=America/Bogota

# --- Acceso: local o remoto -----------------------------------------------
# Dirección en la que el host publica los puertos del stack:
#   127.0.0.1   solo esta máquina (por defecto, desarrollo local)
#   0.0.0.0     todas las interfaces (LAN o internet)
#   <IP>        solo esa interfaz, p. ej. la IP de tu VPN  <- la opción más segura
BIND_ADDRESS=127.0.0.1

# Estos dos solo importan si BIND_ADDRESS deja de ser 127.0.0.1.
# En local son cómodos; expuestos son un agujero. Cámbialos al exponer:
PGADMIN_SERVER_MODE=False   # True  -> pgAdmin exige login (obligatorio en remoto)
PMA_ARBITRARY=1             # 0     -> phpMyAdmin solo habla con el MariaDB del compose

# --- PostgreSQL 17 --------------------------------------------------------
POSTGRES_USER=USUARIO_POSTGRES
POSTGRES_PASS=PASSWORD_POSTGRES
POSTGRES_DB=BASE_DE_DATOS_POSTGRES
POSTGRES_PORT=5432

# --- PostgreSQL 17 + pgvector ---------------------------------------------
# Usa el mismo POSTGRES_USER / POSTGRES_PASS de arriba; solo cambian DB y puerto.
POSTGRES_VECTOR_DB=BASE_DE_DATOS_VECTOR
POSTGRES_VECTOR_PORT=5433

# --- pgAdmin 4 ------------------------------------------------------------
# Debe ser un email con formato válido: pgAdmin no arranca si no lo es.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=SU_PASSWORD
PGADMIN_PORT=8081

# --- MariaDB --------------------------------------------------------------
MARIADB_USER=USUARIO_MARIADB
MARIADB_PASSWORD=PASSWORD_MARIADB
MARIADB_DATABASE=BASE_DATOS_MARIADB
MARIADB_ROOT_PASSWORD=PASSWORD_ROOT_MARIADB
MARIADB_PORT=3306

# --- phpMyAdmin -----------------------------------------------------------
# El login se hace con un usuario de MariaDB (MARIADB_USER o root) en su pantalla.
# PMA_ARBITRARY está en la sección "Acceso" del principio.
PMA_PORT=8082

# --- Backup (perfil opcional: docker compose --profile backup up -d) ------
# Los dumps se escriben en ./backups/ del repo.
BACKUP_INTERVAL=86400        # segundos entre ciclos de backup (86400 = 24h)
BACKUP_RETENTION_DAYS=7      # borra los .sql.gz con más días que esto

# Dueño de los archivos generados en ./backups (solo aplica en Linux nativo).
# Obtén los tuyos con:  echo "UID=$(id -u)" && echo "GID=$(id -g)"
UID=1000
GID=1000
