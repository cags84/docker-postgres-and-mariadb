# ============================================================================
# Copia este archivo a .env y ajusta los valores:  cp .env.example .env
# Todas las variables de aquí son leídas por docker-compose.yml.
# ============================================================================

# --- PostgreSQL 17 --------------------------------------------------------
POSTGRES_USER=USUARIO_POSTGRES
POSTGRES_PASS=PASSWORD_POSTGRES
POSTGRES_DB=BASE_DE_DATOS_POSTGRES
POSTGRES_TZ=America/Bogota
POSTGRES_PORT=5432

# --- PostgreSQL 17 + pgvector ---------------------------------------------
# Usa el mismo POSTGRES_USER / POSTGRES_PASS de arriba; solo cambian DB y puerto.
POSTGRES_VECTOR_DB=BASE_DE_DATOS_VECTOR
POSTGRES_VECTOR_PORT=5433

# --- pgAdmin 4 ------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=SU_EMAIL
PGADMIN_DEFAULT_PASSWORD=SU_PASSWORD
PGADMIN_PORT=8081

# --- MariaDB --------------------------------------------------------------
MARIADB_USER=USUARIO_MARIADB
MARIADB_PASSWORD=PASSWORD_MARIADB
MARIADB_DATABASE=BASE_DATOS_MARIADB
MARIADB_ROOT_PASSWORD=PASSWORD_ROOT_MARIADB
MARIADB_TZ=America/Bogota
MARIADB_PORT=3306

# --- phpMyAdmin -----------------------------------------------------------
# La contraseña de root la toma de MARIADB_ROOT_PASSWORD (arriba), no se repite aquí.
PMA_TZ=America/Bogota
PMA_PORT=8082

# --- Backup (perfil opcional: docker compose --profile backup up -d) ------
# Los dumps se escriben en ./backups/ del repo.
BACKUP_INTERVAL=86400        # segundos entre ciclos de backup (86400 = 24h)
BACKUP_RETENTION_DAYS=7      # borra los .sql.gz con más días que esto

# Dueño de los archivos generados en ./backups (solo aplica en Linux nativo).
# Obtén los tuyos con:  echo "UID=$(id -u)" && echo "GID=$(id -g)"
UID=1000
GID=1000
